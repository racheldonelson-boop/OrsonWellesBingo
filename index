<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orson Welles Film Technique BINGO</title>
  <style>
    :root {
      --bg-color: #121212;
      --card-bg: #1e1e1e;
      --cell-bg: #2a2a2a;
      --cell-active: #8b6b1b;
      --text-color: #f0f0f0;
      --accent-color: #d4af37;
      --border-color: #444444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 10px;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 800px;
      background-color: var(--card-bg);
      border: 2px solid var(--accent-color);
      border-radius: 8px;
      padding: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    }

    header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 15px;
    }

    header img {
      width: 110px;
      height: 110px;
      object-fit: cover;
      border-radius: 50%;
      border: 2px solid var(--accent-color);
      filter: grayscale(100%) contrast(120%);
    }

    .header-text {
      flex: 1;
    }

    h1 {
      font-size: 1.8rem;
      color: var(--accent-color);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    p.subtitle {
      font-style: italic;
      font-size: 0.95rem;
      color: #ccc;
      margin-top: 4px;
    }

    .controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      gap: 10px;
    }

    .btn {
      background-color: transparent;
      border: 1px solid var(--accent-color);
      color: var(--accent-color);
      padding: 8px 16px;
      font-family: inherit;
      font-size: 0.9rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s ease;
    }

    .btn:hover {
      background-color: var(--accent-color);
      color: #000;
    }

    .bingo-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
      width: 100%;
    }

    .grid-header {
      background-color: var(--accent-color);
      color: #000;
      font-weight: bold;
      font-size: 1.4rem;
      text-align: center;
      padding: 8px 0;
      border-radius: 4px;
    }

    .cell {
      background-color: var(--cell-bg);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 8px;
      min-height: 100px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
      cursor: pointer;
      user-select: none;
      transition: background-color 0.2s, border-color 0.2s;
    }

    .cell.selected {
      background-color: var(--cell-active);
      border-color: #ffd700;
    }

    .cell.free-space {
      background-color: #3a3219;
      border-color: var(--accent-color);
      font-weight: bold;
      justify-content: center;
    }

    .technique-title {
      font-size: 0.85rem;
      font-weight: 600;
      line-height: 1.25;
      margin-bottom: 6px;
    }

    .film-input-container {
      margin-top: 4px;
    }

    .film-input {
      width: 100%;
      background: rgba(0, 0, 0, 0.4);
      border: none;
      border-bottom: 1px solid #888;
      color: #fff;
      font-size: 0.75rem;
      text-align: center;
      padding: 2px 4px;
      font-family: sans-serif;
    }

    .film-input:focus {
      outline: none;
      border-bottom-color: var(--accent-color);
    }

    .print-line {
      display: none;
      font-size: 0.75rem;
      margin-top: 6px;
      border-top: 1px solid #666;
      padding-top: 2px;
    }

    /* Print Stylesheet */
    @media print {
      body {
        background-color: #fff;
        color: #000;
        padding: 0;
      }

      .container {
        border: none;
        box-shadow: none;
        max-width: 100%;
        padding: 0;
      }

      header img {
        width: 80px;
        height: 80px;
        filter: grayscale(100%);
      }

      h1 {
        color: #000;
        font-size: 1.6rem;
      }

      p.subtitle {
        color: #333;
      }

      .controls {
        display: none !important;
      }

      .grid-header {
        background-color: #e0e0e0;
        color: #000;
        border: 1px solid #000;
      }

      .cell {
        background-color: #fff !important;
        border: 1px solid #000 !important;
        color: #000 !important;
        min-height: 110px;
      }

      .technique-title {
        font-size: 0.8rem;
      }

      .film-input-container {
        display: none;
      }

      .print-line {
        display: block;
        margin-top: 8px;
        text-align: left;
        font-size: 0.75rem;
      }
    }

    @media (max-width: 600px) {
      header {
        flex-direction: column;
        text-align: center;
      }
      .cell {
        min-height: 85px;
        padding: 4px;
      }
      .technique-title {
        font-size: 0.72rem;
      }
      .film-input {
        font-size: 0.7rem;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <img src="welles.jpg" alt="Orson Welles" id="header-img" onerror="this.style.display='none'" />
      <div class="header-text">
        <h1>Orson Welles</h1>
        <p class="subtitle">Cinematic Technique BINGO</p>
      </div>
    </header>

    <div class="controls">
      <button class="btn" onclick="window.print()">Print Board</button>
      <button class="btn" onclick="resetBoard()">Reset Game</button>
    </div>

    <div class="bingo-grid" id="bingoGrid">
      <!-- Headers -->
      <div class="grid-header">B</div>
      <div class="grid-header">I</div>
      <div class="grid-header">N</div>
      <div class="grid-header">G</div>
      <div class="grid-header">O</div>

      <!-- Rows built dynamically -->
    </div>
  </div>

  <script>
    const bingoData = [
      // Row 1
      { title: "Wide-Angle Lens Distortion", type: "normal" },
      { title: "Chiaroscuro / Hard Shadows", type: "normal" },
      { title: "Forced Perspective Set Design", type: "normal" },
      { title: "Kinetic / Rapid Action Editing", type: "normal" },
      { title: "Multi-Story Tracking Shot", type: "normal" },

      // Row 2
      { title: "Low-Angle / Exposed Ceiling", type: "normal" },
      { title: "Volumetric Light (Smoke/Fog)", type: "normal" },
      { title: "Clockwork / Mechanical Set", type: "normal" },
      { title: "Graphic Match Dissolve", type: "normal" },
      { title: "Foreground-to-Background Pan", type: "normal" },

      // Row 3
      { title: "In-Camera Deep Focus", type: "normal" },
      { title: "Slatted Shadows (Blinds/Beams)", type: "normal" },
      { title: "FREE SPACE<br><small>(Deep Depth of Field)</small>", type: "free" },
      { title: "Undercranked Frame Rate", type: "normal" },
      { title: "Reflection / Mirror Split", type: "normal" },

      // Row 4
      { title: "Virtuoso Multi-Minute Long Take", type: "normal" },
      { title: "Stark Silhouetted Backlighting", type: "normal" },
      { title: "Cavernous Set / Low Beams", type: "normal" },
      { title: "Newsreel / Multi-Media Style", type: "normal" },
      { title: "Whip Pan / Fast Swivel", type: "normal" },

      // Row 5
      { title: "Sunk-Camera Trench Angle", type: "normal" },
      { title: "Mixed Film Stocks (16mm/35mm)", type: "normal" },
      { title: "Deep Recessed Corridor", type: "normal" },
      { title: "Jarring Jump Cut / Flash Frame", type: "normal" },
      { title: "Split-Diopter Dual Focus", type: "normal" }
    ];

    const gridEl = document.getElementById("bingoGrid");

    function renderGrid() {
      const savedState = JSON.parse(localStorage.getItem("welles_bingo_state") || "{}");
      const savedTitles = JSON.parse(localStorage.getItem("welles_bingo_titles") || "{}");

      bingoData.forEach((item, index) => {
        const cell = document.createElement("div");
        cell.className = "cell" + (item.type === "free" ? " free-space" : "");
        cell.dataset.index = index;

        if (savedState[index]) {
          cell.classList.add("selected");
        }

        const titleDiv = document.createElement("div");
        titleDiv.className = "technique-title";
        titleDiv.innerHTML = item.title;
        cell.appendChild(titleDiv);

        if (item.type !== "free") {
          const inputContainer = document.createElement("div");
          inputContainer.className = "film-input-container";

          const input = document.createElement("input");
          input.type = "text";
          input.className = "film-input";
          input.placeholder = "Film title...";
          input.value = savedTitles[index] || "";

          input.addEventListener("click", (e) => e.stopPropagation());
          input.addEventListener("input", (e) => {
            savedTitles[index] = e.target.value;
            localStorage.setItem("welles_bingo_titles", JSON.stringify(savedTitles));
          });

          inputContainer.appendChild(input);
          cell.appendChild(inputContainer);

          const printLine = document.createElement("div");
          printLine.className = "print-line";
          printLine.innerText = "Film: ____________";
          cell.appendChild(printLine);
        }

        cell.addEventListener("click", () => {
          cell.classList.toggle("selected");
          savedState[index] = cell.classList.contains("selected");
          localStorage.setItem("welles_bingo_state", JSON.stringify(savedState));
        });

        gridEl.appendChild(cell);
      });
    }

    function resetBoard() {
      if (confirm("Are you sure you want to clear your card markings and titles?")) {
        localStorage.removeItem("welles_bingo_state");
        localStorage.removeItem("welles_bingo_titles");
        location.reload();
      }
    }

    renderGrid();
  </script>
</body>
</html>
